{
    "name": "easyswoole/trace",
    "type": "library",
    "description": "A lightweight manual call-chain timing tracer for PHP",
    "keywords" : ["swoole", "framework", "async","easyswoole"],
    "homepage" : "https://www.easyswoole.com/",
    "license" : "Apache-2.0",
    "authors": [
        {
            "name": "YF",
            "email": "291323003@qq.com"
        }
    ],
    "require": {
        "php": ">=8.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "easyswoole/swoole-ide-helper": "*"
    },
    "autoload": {
        "psr-4": {
            "EasySwoole\\Trace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasySwoole\\Trace\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
